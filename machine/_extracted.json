  {
   "name": "add_both_sides",
   "arity": 1,
   "params": [
    "by"
   ],
   "apply": "go",
   "obligations": [],
   "side_conditions": [],
   "shape": "a = b  |-  a + k = b + k",
   "doc": "Adding the same term to both sides preserves equality unconditionally."
  },
  {
   "name": "add_inequality",
   "arity": 1,
   "params": [
    "by"
   ],
   "apply": "_apply_add_inequality",
   "obligations": [],
   "side_conditions": [],
   "shape": "a < b  |-  a + k < b + k",
   "doc": "Translation preserves order for any k."
  },
  {
   "name": "and_elim_left",
   "arity": 1,
   "params": [],
   "apply": "go",
   "obligations": [],
   "side_conditions": [],
   "shape": "P and Q  |-  P",
   "doc": "Conjunction elimination, left."
  },
  {
   "name": "and_elim_right",
   "arity": 1,
   "params": [],
   "apply": "go",
   "obligations": [],
   "side_conditions": [],
   "shape": "P and Q  |-  Q",
   "doc": "Conjunction elimination, right."
  },
  {
   "name": "and_intro",
   "arity": 2,
   "params": [],
   "apply": "_apply_and_intro",
   "obligations": [],
   "side_conditions": [],
   "shape": "P, Q  |-  P and Q",
   "doc": "Conjunction introduction."
  },
  {
   "name": "congruence",
   "arity": 1,
   "params": [
    "fn"
   ],
   "apply": "_apply_congruence",
   "obligations": [],
   "side_conditions": [],
   "shape": "a = b  |-  f(a) = f(b)",
   "doc": "Functions respect equality. f must be a named unary function."
  },
  {
   "name": "divide_both_sides",
   "arity": 1,
   "params": [
    "by"
   ],
   "apply": "go",
   "obligations": [],
   "side_conditions": [],
   "shape": "a = b  |-  a / k = b / k   [requires k != 0]",
   "doc": "Dividing both sides is sound only for a non-zero divisor. The obligation comes from the term, not from this spec -- see reasoning/partiality.py."
  },
  {
   "name": "exists_intro",
   "arity": 1,
   "params": [
    "var"
   ],
   "apply": "_apply_exists_intro",
   "obligations": [],
   "side_conditions": [],
   "shape": "phi(a)  |-  exists a : D . phi(a)   [a is a typed witness]",
   "doc": "Existential introduction from a checked witness fact. The witness is a resolved module-level variable and the binder uses its exact declared domain; this rule does not assert uniqueness."
  },
  {
   "name": "forall_elim",
   "arity": 1,
   "params": [
    "at"
   ],
   "apply": "_apply_forall_elim",
   "obligations": [],
   "side_conditions": [
    "instantiation_domain"
   ],
   "shape": "forall x : D . phi(x)  |-  phi[t/x]   [requires t : D]",
   "doc": "Universal instantiation. Substitution is capture-avoiding, and a term mentioning a bound name is refused rather than substituted. The instantiation term must inhabit the binder's declared domain."
  },
  {
   "name": "forall_intro",
   "arity": 1,
   "params": [
    "var"
   ],
   "apply": "_apply_forall_intro",
   "obligations": [],
   "side_conditions": [
    "eigenvariable"
   ],
   "shape": "phi(a)  |-  forall a : D . phi(a)   [a arbitrary]",
   "doc": "Universal introduction. The variable must be ARBITRARY: it may not occur free in any assumption in scope, or the proof was about that particular value and generalising it is unsound. Proving phi for many sample values is not this rule and never becomes it."
  },
  {
   "name": "modus_ponens",
   "arity": 2,
   "params": [],
   "apply": "_apply_modus_ponens",
   "obligations": [],
   "side_conditions": [],
   "shape": "P, P implies Q  |-  Q",
   "doc": "The antecedent must match the implication's left side exactly."
  },
  {
   "name": "modus_tollens",
   "arity": 2,
   "params": [],
   "apply": "_apply_modus_tollens",
   "obligations": [],
   "side_conditions": [],
   "shape": "not Q, P implies Q  |-  not P",
   "doc": "Denying the consequent."
  },
  {
   "name": "multiply_both_sides",
   "arity": 1,
   "params": [
    "by"
   ],
   "apply": "go",
   "obligations": [],
   "side_conditions": [],
   "shape": "a = b  |-  a * k = b * k",
   "doc": "Multiplying both sides preserves equality for any k, including zero."
  },
  {
   "name": "multiply_inequality",
   "arity": 1,
   "params": [
    "by"
   ],
   "apply": "_apply_multiply_inequality",
   "obligations": [
    "ObligationSpec(build=<function _gt_zero at 0x105ed4a40>, reason='order_preserving_multiplier', mandatory=True)"
   ],
   "side_conditions": [],
   "shape": "a < b  |-  a * k < b * k   [requires k > 0]",
   "doc": "Scaling preserves the direction of an inequality only for a positive multiplier; the obligation is mandatory."
  },
  {
   "name": "reflexivity",
   "arity": 0,
   "params": [
    "term"
   ],
   "apply": "_apply_reflexivity",
   "obligations": [],
   "side_conditions": [],
   "shape": "|- t = t",
   "doc": "Equality is reflexive for every well-typed, defined term. Partial terms retain their ordinary term-level definedness obligations."
  },
  {
   "name": "substitute",
   "arity": 2,
   "params": [],
   "apply": "_apply_substitute",
   "obligations": [],
   "side_conditions": [],
   "shape": "a = b, P  |-  P[a := b]",
   "doc": "Substitution of equals. Does not descend into quantifier bodies, so a step that would require capture-avoiding substitution is REJECTED rather than performed unsoundly."
  },
  {
   "name": "subtract_both_sides",
   "arity": 1,
   "params": [
    "by"
   ],
   "apply": "go",
   "obligations": [],
   "side_conditions": [],
   "shape": "a = b  |-  a - k = b - k",
   "doc": "Subtracting the same term from both sides preserves equality."
  },
  {
   "name": "symmetry",
   "arity": 1,
   "params": [],
   "apply": "_apply_symmetry",
   "obligations": [],
   "side_conditions": [],
   "shape": "a = b  |-  b = a",
   "doc": "Equality is symmetric."
  },
  {
   "name": "transitivity",
   "arity": 2,
   "params": [],
   "apply": "_apply_transitivity",
   "obligations": [],
   "side_conditions": [],
   "shape": "a = b, b = c  |-  a = c",
   "doc": "Equality is transitive. The shared middle term must match exactly."
  },
